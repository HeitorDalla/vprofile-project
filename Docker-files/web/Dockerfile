# IMAGEM BASE
FROM nginx:1.27

# LABELS
LABEL "Project"="Vprofile"
LABEL "Author"="Heitor"

# DEFININDO AS VARIÁVEIS DE AMBIENTE (NGINX_ENTRYPOINT_QUIET_LOGS = VER O QUE ESTA ACONTECENDO DURANTE A EXECUCAO DO CONTAINER)
ENV NGINX_ENTRYPOINT_QUIET_LOGS=1

# COMANDOS QUE SERÃO EXECUTADOS DURANTE A CRIACAO DO CONTAINER
# REMOVER AS CONFIGURAÇÕES INICIAIS DO NGINX
RUN rm -rf /etc/nginx/conf.d/default.conf

# COPIA O ARQUIVO DE CONFIGURAÇÃO PARA DENTRO DO CONTAINER
COPY nginvproapp.conf /etc/nginx/conf.d/vproapp.conf